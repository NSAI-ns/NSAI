{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Chạy trực tiếp (F5 mở Chrome)",
            "file": "${workspaceFolder}/HTML/index.html"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Chạy qua Live Server (Port 5500)",
